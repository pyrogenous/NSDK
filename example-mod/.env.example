# Copy this file to .env and fill it in. .env is git-ignored: never commit your SDK key.
# The key is shown once when you create the project on https://nitea.cc (Project settings > SDK key).
NITEA_SDK_KEY=nt_your_sdk_key

# Optional: send to a local copy of the website while developing it
# NITEA_ENDPOINT=http://localhost:3000
